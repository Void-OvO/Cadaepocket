PORT=3000
DB_FILE=data/catolimi.db
# POST /api/admin/crawl 호출용 토큰 (비우면 관리자 API 비활성)
ADMIN_TOKEN=
# 자동 수집 주기(분). 0 이면 끔
CRAWL_INTERVAL_MIN=30
# 게시판(분류)마다 항상 보는 페이지 수. 그 뒤로는 처음 보는 최근 글(BACKFILL_DAYS 이내)이 나오는 동안 PAGE_CAP 까지 더 넘긴다
CRAWL_MAX_PAGES=2
CRAWL_BACKFILL_DAYS=30
CRAWL_PAGE_CAP=15
CRAWL_DEPT_PAGE_CAP=5
CRAWL_DELAY_MS=700
RECHECK_DAYS=14
# 학과 게시판(성심 학과 약 37곳) 수집. 0 이면 끔. 학과마다 가져올 목록 페이지 수
CRAWL_DEPTS=1
CRAWL_DEPT_PAGES=1
# 학과 공지도 Claude 로 분석하려면 1 (기본은 규칙 기반: 학과 공지가 많아 API 비용 절약)
DEPT_AI=0
# 이미지 공지 글자 읽기(Tesseract OCR). 0 이면 끔. 서버에는 setup.sh 가 tesseract-ocr·tesseract-ocr-kor 를 설치
OCR=1
# OCR_LANG=kor+eng
# OCR_MAX_IMAGES=4
# 이미지(포스터) 공지까지 읽고 자격요건을 뽑으려면 입력. 없으면 규칙 기반으로 대체
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 공지 제목·요약을 영어·중국어로 번역 (DeepL API Free: 월 50만 자 무료). Claude 키가 있으면 Claude 가 번역하고, 없을 때 이 키를 쓴다
DEEPL_API_KEY=
# npm run vapid 로 생성한 푸시 키
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
