flowchart TD
  DT(["공지 상세 진입"]) --> L{"목록에 있는 공지?"}
  L -- "아니오 · 푸시로 진입" --> LD["GET /api/notices/:id 로 하나만 불러오기"]
  L -- "예" --> V
  LD --> V["상세 화면"]
  V --> V1["정정 상자<br/>바뀐 항목 이전 → 이후 + AI 요약"]
  V --> V2["확인 필요 안내<br/>조건을 확정하지 못한 공지"]
  V --> V3["내 조건 비교<br/>학적 · 학과 · 학년 · 이수 학기 · 평점 ✓ ✕ ?<br/>학과를 비워 뒀으면 학과는 ? · 학과를 입력하지 않았어요"]
  V --> V4["AI 요약<br/>대상 · 기간 · 혜택 · 서류 · 신청 방법"]
  V --> V5["첨부파일"]
  V --> V6["분석 오류 신고 → POST /api/reports"]
  V --> V7["원문 보기 → 학교 사이트"]
  V --> SAVE["공지 저장"]
  SAVE --> T{"상황별 안내"}
  T -- "마감일 없음" --> T1["저장 탭에서 볼 수 있어요"]
  T -- "푸시 켜짐" --> T2["마감 N일 전에 알려드릴게요"]
  T -- "푸시 꺼짐" --> T3["설정에서 푸시를 켜면 마감 전에 알려드려요"]
  SAVE -. 푸시 켜짐 .-> SY["saved 목록 서버 동기화"]
