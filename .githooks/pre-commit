#!/bin/sh
# master 에는 직접 커밋하지 않는다. 개발은 develop 에서 (CONTRIBUTING.md)
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "master" ]; then
  echo ""
  echo "  master 에는 직접 커밋할 수 없어요. master 는 테스트를 마친 코드만 develop 에서 머지합니다."
  echo "  개발은 develop 에서 하세요:"
  echo "    git stash && git checkout develop && git stash pop"
  echo ""
  exit 1
fi
